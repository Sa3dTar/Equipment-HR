<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_medical" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.medical</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <!-- إضافة الحقل بجانب بيانات الموظف الأساسية بطريقة آمنة باستخدام السحب على الـ sheet أو group -->
            <xpath expr="//sheet/group" position="inside">
                <group string="Medical Technical Settings">
                    <field name="is_medical_technician" widget="boolean_toggle"/>
                </group>
            </xpath>

            <!-- إضافة التبويب الجديد داخل الـ notebook الرئيسي للموظف -->
            <xpath expr="//notebook" position="inside">
                <page string="Medical Technical Info" name="medical_technical_info">
                    <group>
                        <field name="is_medical_technician" widget="boolean_toggle"/>
                    </group>
                    <separator string="Certifications"/>
                    <field name="certification_ids">
                        <list editable="bottom">
                            <field name="certification_name"/>
                            <field name="issuing_body"/>
                            <field name="expiry_date"/>
                            <field name="is_valid" widget="boolean_toggle"/>
                        </list>
                    </field>
                    <separator string="Assigned Work Orders"/>
                    <field name="equipment_work_order_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="equipment_id"/>
                            <field name="failure_type"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>