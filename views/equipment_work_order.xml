<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_equipment_work_order_form" model="ir.ui.view">
        <field name="name">equipment.work.order.form</field>
        <field name="model">equipment.work.order</field>
        <field name="arch" type="xml">
            <form string="Work Order">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,assigned,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="equipment_id"/>
                            <field name="failure_type"/>
                            <field name="assigned_technician_id"/>
                        </group>
                        <group>
                            <field name="start_date_time"/>
                            <field name="end_date_time"/>
                            <field name="downtime_hours"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_equipment_work_order_tree" model="ir.ui.view">
        <field name="name">equipment.work.order.list</field>
        <field name="model">equipment.work.order</field>
        <field name="arch" type="xml">
            <list string="Work Orders">
                <field name="name"/>
                <field name="equipment_id"/>
                <field name="failure_type"/>
                <field name="assigned_technician_id"/>
                <field name="start_date_time"/>
                <field name="end_date_time"/>
                <field name="downtime_hours"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'waiting_parts'" decoration-success="state == 'done'" decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="action_equipment_work_order" model="ir.actions.act_window">
        <field name="name">Work Orders</field>
        <field name="res_model">equipment.work.order</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>