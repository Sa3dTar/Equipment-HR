<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_equipment_preventive_rule_form" model="ir.ui.view">
        <field name="name">equipment.preventive.rule.form</field>
        <field name="model">equipment.preventive.rule</field>
        <field name="arch" type="xml">
            <form string="Preventive Rule">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="equipment_model_id"/>
                        <field name="interval_hours"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_equipment_preventive_rule_tree" model="ir.ui.view">
        <field name="name">equipment.preventive.rule.list</field>
        <field name="model">equipment.preventive.rule</field>
        <field name="arch" type="xml">
            <list string="Preventive Rules">
                <field name="name"/>
                <field name="equipment_model_id"/>
                <field name="interval_hours"/>
            </list>
        </field>
    </record>

    <record id="action_equipment_preventive_rule" model="ir.actions.act_window">
        <field name="name">Preventive Rules</field>
        <field name="res_model">equipment.preventive.rule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>